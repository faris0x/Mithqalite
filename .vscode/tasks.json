{
    // See https://go.microsoft.com/fwlink/?LinkId=733558
    // for the documentation about the tasks.json format
    "version": "2.0.0",
    "tasks": [
        {
            "label": "mithqalite-base: check",
            "type": "shell",
            "command": "cargo check --all-targets",
            "options": {
                "cwd": "${workspaceFolder}/mithqalite-base"
            }
        },
        {
            "label": "mithqalite-base: clippy",
            "type": "shell",
            "command": "cargo clippy --all-targets",
            "options": {
                "cwd": "${workspaceFolder}/mithqalite-base"
            }
        },
        {
            "label": "mithqalite-base: fmt",
            "type": "shell",
            "command": "cargo fmt",
            "options": {
                "cwd": "${workspaceFolder}/mithqalite-base"
            }
        },
        {
            "label": "mithqalite-base: doc",
            "type": "shell",
            "command": "cargo doc --no-deps",
            "options": {
                "cwd": "${workspaceFolder}/mithqalite-base",
                "env": {
                    "RUSTDOCFLAGS": "--html-in-header katex-header.html"
                }
            }
        },
        {
            "label": "mithqalite-base: open docs",
            "type": "shell",
            "command": "open target/doc/mithqalite_base/index.html",
            "options": {
                "cwd": "${workspaceFolder}/mithqalite-base",
            }
        },

        {
            "label": "mithqalite-base-test-util: check",
            "type": "shell",
            "command": "cargo check --all-targets",
            "options": {
                "cwd": "${workspaceFolder}/mithqalite-base-test-util"
            }
        },
        {
            "label": "mithqalite-base-test-util: clippy",
            "type": "shell",
            "command": "cargo clippy --all-targets",
            "options": {
                "cwd": "${workspaceFolder}/mithqalite-base-test-util"
            }
        },
        {
            "label": "mithqalite-base-test-util: fmt",
            "type": "shell",
            "command": "cargo fmt",
            "options": {
                "cwd": "${workspaceFolder}/mithqalite-base-test-util"
            }
        },

        {
            "label": "mithqalite-nz 32: check",
            "type": "shell",
            "command": "cargo check --all-targets --features 32_bit_limbs",
            "options": {
                "cwd": "${workspaceFolder}/mithqalite-nz"
            }
        },
        {
            "label": "mithqalite-nz 32: clippy",
            "type": "shell",
            "command": "cargo clippy --all-targets --features 32_bit_limbs",
            "options": {
                "cwd": "${workspaceFolder}/mithqalite-nz"
            }
